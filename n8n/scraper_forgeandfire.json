{
  "name": "Scraper - Forge & Fire",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 8
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [-800, -352],
      "id": "ff-trigger",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://172.17.0.1:3000/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "name": "Scrape Forge & Fire",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [-560, -352],
      "id": "ff-scrape"
    },
    {
      "parameters": {
        "jsCode": "const body = $json;\nreturn [{ \n  ok: body.ok === true,\n  market: 'forgeandfire',\n  products: body.products || 0,\n  duration_ms: body.duration_ms || 0,\n  ranAt: new Date().toISOString()\n}];"
      },
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-320, -352],
      "id": "ff-normalize"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.ok}}",
              "value2": true
            }
          ]
        },
        "options": {}
      },
      "name": "Check Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-80, -352],
      "id": "ff-check"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/rpc/run_batch_classification",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "name": "Run Classification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [160, -256],
      "id": "ff-classify"
    },
    {
      "parameters": {
        "errorMessage": "={{'Forge & Fire scrape failed: ' + JSON.stringify($json).slice(0, 500)}}"
      },
      "name": "Fail",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [160, -448],
      "id": "ff-fail"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Scrape Forge & Fire", "type": "main", "index": 0 }]]
    },
    "Scrape Forge & Fire": {
      "main": [[{ "node": "Normalize", "type": "main", "index": 0 }]]
    },
    "Normalize": {
      "main": [[{ "node": "Check Success", "type": "main", "index": 0 }]]
    },
    "Check Success": {
      "main": [
        [{ "node": "Run Classification", "type": "main", "index": 0 }],
        [{ "node": "Fail", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
