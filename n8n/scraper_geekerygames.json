{
  "name": "Scraper - GeekeryGames",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 8 }] }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [-800, -352],
      "id": "gg-trigger",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://172.17.0.1:3000/jobs/geekerygames/crawl",
        "options": { "timeout": 300000 }
      },
      "name": "Crawl GeekeryGames",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [-560, -352],
      "id": "gg-crawl"
    },
    {
      "parameters": {
        "jsCode": "const body = $json;\nreturn [{ ok: body.ok === true, market: 'geekerygames', products_found: body.products_found || 0, offers_ok: body.offers_ok || 0, offers_failed: body.offers_failed || 0, duration_ms: body.duration_ms || 0, ranAt: new Date().toISOString() }];"
      },
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-320, -352],
      "id": "gg-normalize"
    },
    {
      "parameters": {
        "conditions": { "boolean": [{ "value1": "={{$json.ok}}", "value2": true }] },
        "options": {}
      },
      "name": "Check Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-80, -352],
      "id": "gg-check"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/rpc/run_batch_classification",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "Authorization", "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": { "timeout": 120000 }
      },
      "name": "Run Classification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [160, -256],
      "id": "gg-classify"
    },
    {
      "parameters": {
        "errorMessage": "={{'GeekeryGames crawl failed: ' + JSON.stringify($json).slice(0, 500)}}"
      },
      "name": "Fail",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [160, -448],
      "id": "gg-fail"
    }
  ],
  "connections": {
    "Schedule Trigger": { "main": [[{ "node": "Crawl GeekeryGames", "type": "main", "index": 0 }]] },
    "Crawl GeekeryGames": { "main": [[{ "node": "Normalize", "type": "main", "index": 0 }]] },
    "Normalize": { "main": [[{ "node": "Check Success", "type": "main", "index": 0 }]] },
    "Check Success": { "main": [
      [{ "node": "Run Classification", "type": "main", "index": 0 }],
      [{ "node": "Fail", "type": "main", "index": 0 }]
    ]}
  },
  "active": true,
  "settings": { "executionOrder": "v1" }
}
