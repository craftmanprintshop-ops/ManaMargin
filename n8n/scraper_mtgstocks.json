{
  "name": "Scraper - MTGStocks",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 12 }] }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [-800, -352],
      "id": "mtgs-trigger",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://172.17.0.1:3000/jobs/mtgstocks/scrape",
        "options": { "timeout": 300000 }
      },
      "name": "Scrape MTGStocks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [-560, -352],
      "id": "mtgs-scrape"
    },
    {
      "parameters": {
        "jsCode": "const body = $json;\nreturn [{ ok: body.ok === true, market: 'mtgstocks', products_found: body.products_found || 0, inserted: body.inserted || 0, skipped: body.skipped || 0, duration_ms: body.duration_ms || 0, ranAt: new Date().toISOString() }];"
      },
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-320, -352],
      "id": "mtgs-normalize"
    },
    {
      "parameters": {
        "conditions": { "boolean": [{ "value1": "={{$json.ok}}", "value2": true }] },
        "options": {}
      },
      "name": "Check Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-80, -352],
      "id": "mtgs-check"
    },
    {
      "parameters": {
        "jsCode": "return [{ ok: true, market: 'mtgstocks', ranAt: $json.ranAt, products_found: $json.products_found, inserted: $json.inserted, duration_ms: $json.duration_ms }];"
      },
      "name": "Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [160, -256],
      "id": "mtgs-success"
    },
    {
      "parameters": {
        "errorMessage": "={{'MTGStocks scrape failed: ' + JSON.stringify($json).slice(0, 500)}}"
      },
      "name": "Fail",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [160, -448],
      "id": "mtgs-fail"
    }
  ],
  "connections": {
    "Schedule Trigger": { "main": [[{ "node": "Scrape MTGStocks", "type": "main", "index": 0 }]] },
    "Scrape MTGStocks": { "main": [[{ "node": "Normalize", "type": "main", "index": 0 }]] },
    "Normalize": { "main": [[{ "node": "Check Success", "type": "main", "index": 0 }]] },
    "Check Success": { "main": [
      [{ "node": "Success", "type": "main", "index": 0 }],
      [{ "node": "Fail", "type": "main", "index": 0 }]
    ]}
  },
  "active": true,
  "settings": { "executionOrder": "v1" }
}
