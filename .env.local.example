# Supabase Configuration
# Copy this file to .env.local and fill in your actual values

# Your Supabase project URL (from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anonymous/public key (from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Your Supabase project ID (for generating types)
SUPABASE_PROJECT_ID=your-project-id

# Web Push: VAPID public key. Generate a pair with:
#   npx web-push generate-vapid-keys
# Public half goes here; private half goes in the deal watcher's .env only.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here
